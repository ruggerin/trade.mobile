# Copie pra .env.local (git-ignorado) e ajuste pro seu cenário.
# Sem essa variável, o app tenta auto-detectar o IP do PC via Metro — só funciona
# com celular e PC na mesma rede local.

# IP fixo na rede local:
# EXPO_PUBLIC_API_URL=http://192.4.1.140:8000/api

# Túnel Cloudflare (cloudflared tunnel --url http://localhost:8000), útil pra testar
# fora da rede local (dados móveis, celular de outra pessoa, etc):
# EXPO_PUBLIC_API_URL=https://algum-nome-aleatorio.trycloudflare.com/api

# API de teste (trade-teste), usada pro build preview do EAS:
EXPO_PUBLIC_API_URL=http://192.4.1.140:8000/api
