{
  "expo": {
    "name": "Horus",
    "slug": "horus",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prossigatec.horus",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização pra confirmar que você está no ponto de venda na hora do check-in.",
        "NSCameraUsageDescription": "Usamos a câmera pra registrar fotos dos produtos durante a visita.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Usamos sua localização, mesmo com o app fechado, pra que seu gestor acompanhe sua rota durante o expediente.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "package": "com.prossigatec.horus",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#f4ebe3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCAGRBHV_NZtYwx852vM7zgQHjIEBwYEm0"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização pra confirmar que você está no ponto de venda na hora do check-in.",
          "locationAlwaysAndWhenInUsePermission": "Usamos sua localização, mesmo com o app fechado, pra que seu gestor acompanhe sua rota durante o expediente.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usamos a câmera pra registrar fotos dos produtos durante a visita."
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.adapters.react.apploader.** { *; }\n-keep class expo.modules.apploader.** { *; }\n-keep class expo.modules.taskManager.** { *; }\n-keep class expo.modules.location.** { *; }"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos o Face ID para desbloquear o Horus sem digitar a senha."
        }
      ],
      "./plugins/withExpoSourcesJarFix",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#4f46e5"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "prossiga-d7",
          "project": "horus-mobile-beta"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ddef4169-e19c-4fc8-9a55-5adbbc269c7e"
      }
    },
    "owner": "prossigatec.com.br"
  }
}
