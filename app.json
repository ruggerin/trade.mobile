{
  "expo": {
    "name": "PDV App",
    "slug": "pdv-app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização pra confirmar que você está no ponto de venda na hora do check-in.",
        "NSCameraUsageDescription": "Usamos a câmera pra registrar fotos dos produtos durante a visita."
      }
    },
    "android": {
      "package": "com.stoneup.pdvapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização pra confirmar que você está no ponto de venda na hora do check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usamos a câmera pra registrar fotos dos produtos durante a visita."
        }
      ],
      "expo-status-bar",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "f931506a-4879-4b56-8532-29f2883b08f6"
      }
    },
    "owner": "dev.stoneup"
  }
}
